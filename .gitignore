# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log

# env files — NEVER commit real credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.local.example IS committed (template only, no real secrets)

# vercel
.vercel

# editor
.vscode
.idea

# local database files (SQLite, Prisma local dev DBs)
*.db
*.db-journal
*.sqlite
*.sqlite3

# cache
.cache

# uploads/temp
/uploads
/tmp
/temp

# typescript
*.tsbuildinfo
