// Prisma schema — Moj Auto Diler platform
// Provider: PostgreSQL (Neon)
// Run: npx prisma generate && npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  HIDDEN
}

enum LeadStatus {
  NEW
  CONTACTED
  SCHEDULED
  RESERVED
  SOLD
  LOST
  CLOSED
  SPAM
}

enum AdminRole {
  ADMIN
  MANAGER
}

enum VatMode {
  INCLUDED
  EXCLUDED
  NONE
}

enum DealerStatus {
  ACTIVE
  HIDDEN
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Vehicle {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  brand          String
  model          String
  generation     String?

  year           Int
  mileage        Int
  price          Float
  currency       String        @default("EUR")
  vatMode        VatMode       @default(NONE)

  // Stored as Serbian strings matching the existing TypeScript types
  // e.g. fuelType: 'benzin' | 'dizel' | 'hibrid' | 'elektricni' | 'lpg' | 'cng'
  fuelType       String
  transmission   String
  drivetrain     String
  bodyType       String
  condition      String        @default("polovno")

  engineSize     Int?
  horsepower     Int?
  kilowatts      Int?
  doors          Int           @default(4)
  seats          Int           @default(5)

  color          String
  interiorColor  String?
  vin            String?
  registration   String?
  origin         String?

  description    String
  dealerNotes    String?

  // Arrays stored as PostgreSQL text arrays
  equipment      String[]
  safetyFeatures String[]
  features       String[]
  images         String[]      // URL strings; mapped to VehicleImage[] in app layer
  tags           String[]

  videoUrl       String?       // Optional YouTube / direct URL

  status         VehicleStatus @default(AVAILABLE)
  featured       Boolean       @default(false)

  dealerId       String?
  dealer         Dealer?       @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  contactPhone   String?
  contactViber   String?
  contactName    String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  leads          Lead[]
  media          VehicleMedia[]

  @@index([status])
  @@index([brand])
  @@index([dealerId])
  @@index([featured])
  @@index([createdAt])
}

model Dealer {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  logo         String?
  phone        String
  viber        String?
  instagram    String?
  facebook     String?
  location     String
  address      String?
  description  String?
  workingHours String?
  isVerified   Boolean      @default(true)
  status       DealerStatus @default(ACTIVE)

  vehicles     Vehicle[]
  leads        Lead[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([slug])
}

// ─── Vehicle media ────────────────────────────────────────────────────────────
// Stores one record per image/video. r2Key is set only for files uploaded via
// the admin panel to Cloudflare R2; external/mock URLs have r2Key = null.
// Vehicle.images (String[]) stays as a denormalised ordered URL cache so all
// existing read paths continue to work without changes.

model VehicleMedia {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url        String   // Public CDN / R2 URL
  r2Key      String?  // R2 object key — null for pre-existing / external images
  type       String   @default("image") // "image" | "video"
  mimeType   String?
  sizeBytes  Int?

  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([vehicleId, url])
  @@index([vehicleId, sortOrder])
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  phone        String
  email        String?
  message      String
  source       String?    // 'web' | 'viber' | 'instagram' | 'facebook'
  type         String?    // 'inquiry' | 'contact' | 'test_drive' | 'financing'

  vehicleId    String?
  vehicle      Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleTitle String?    // Denormalized for display when vehicle is deleted

  dealerId     String?
  dealer       Dealer?    @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  dealerName   String?

  status       LeadStatus @default(NEW)
  intent       String     @default("general_inquiry")
  preferredContactChannel String @default("web")

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([dealerId])
  @@index([intent])
  @@index([createdAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(ADMIN)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // TODO: Add session/token relation when auth is implemented
}

model DealerSettings {
  id           String   @id @default(cuid())
  businessName String   @default("Moj Auto Diler")
  phone        String   @default("")
  smsPhone     String?
  email        String   @default("")
  address      String   @default("")
  city         String   @default("Srbija")
  country      String   @default("Serbia")
  workingHours String   @default("")
  viber        String?
  whatsapp     String?
  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  mapUrl       String?

  updatedAt    DateTime @updatedAt
}
