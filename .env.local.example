# ─── Required ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled recommended for serverless)
# Get it from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# ─── Optional ─────────────────────────────────────────────────────────────────
# Email for the placeholder admin user created by the seed script
# ADMIN_EMAIL="admin@autoelite.rs"
