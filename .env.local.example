# ─── TEMPLATE — safe to commit, contains NO real credentials ─────────────────
#
# Usage:
#   cp .env.local.example .env.local
#   Fill in your real values in .env.local — that file is gitignored.
#
# WARNING: Never paste a real DATABASE_URL or any secret directly into THIS file.
# ─────────────────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (pooled recommended for serverless)
# Get it from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-YOURPROJECT.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Admin authentication ─────────────────────────────────────────────────────
# Temporary credential-based auth — replace with DB session when ready.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
# Random secret used to sign session tokens (min 32 chars in production)
ADMIN_SECRET="replace-with-at-least-32-random-chars"

# ─── Cloudflare R2 image storage ──────────────────────────────────────────────
# Cloudflare dashboard → Account Home → (top-right) Account ID
R2_ACCOUNT_ID="your-cloudflare-account-id"
# Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API Token
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# The bucket you created (e.g. mojautodiler-media)
R2_BUCKET_NAME="mojautodiler-media"
# R2 → your bucket → Settings → Public access → Custom domain or r2.dev URL
# e.g. https://pub-abc123.r2.dev  OR  https://media.yourdomain.com
R2_PUBLIC_URL="https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev"

# ─── Media cleanup ────────────────────────────────────────────────────────────
# Secret used to authorise POST /api/admin/media/cleanup-temp from a cron job.
# Generate with: openssl rand -hex 32
# Set the same value as CRON_SECRET in Vercel if using Vercel Cron.
MEDIA_CLEANUP_SECRET="replace-with-a-random-secret-min-32-chars"

# ─── AI Marketing Image Generator ────────────────────────────────────────────
# Optional. When set, OpenAI gpt-4o-mini analyses vehicle data and suggests
# a colour theme, accent colour, and Serbian tagline for the marketing poster.
# If not set, a deterministic fallback based on brand/price is used instead.
# The feature works fully without this key.
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Public site URL — used to build canonical listing URLs in the marketing poster.
# Default: https://mojautodiler.rs
NEXT_PUBLIC_SITE_URL="https://mojautodiler.rs"

# ─── Email notifications (Zoho SMTP) ─────────────────────────────────────────
# Leave ZOHO_SMTP_HOST blank to disable email (leads still save to the database).
# Port 465 uses SSL (secure: true). Generate an App Password in Zoho Mail settings.
ZOHO_SMTP_HOST="smtp.zoho.eu"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER="info@mojautodiler.com"
ZOHO_SMTP_PASS=""

# Destination inbox for all contact-form and lead notifications
CONTACT_EMAIL="info@mojautodiler.com"

# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# Get the Measurement ID from: GA4 → Admin → Data Streams → your stream → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
