# ─── TEMPLATE — safe to commit, contains NO real credentials ─────────────────
#
# Usage:
#   cp .env.local.example .env.local
#   Fill in your real values in .env.local — that file is gitignored.
#
# WARNING: Never paste a real DATABASE_URL or any secret directly into THIS file.
# ─────────────────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (pooled recommended for serverless)
# Get it from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-YOURPROJECT.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Optional ─────────────────────────────────────────────────────────────────
# Email for the placeholder admin user created by the seed script
# ADMIN_EMAIL="admin@autoelite.rs"
