# ─── TEMPLATE — safe to commit, contains NO real credentials ─────────────────
#
# Usage:
#   cp .env.local.example .env.local
#   Fill in your real values in .env.local — that file is gitignored.
#
# WARNING: Never paste a real DATABASE_URL or any secret directly into THIS file.
# ─────────────────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (pooled recommended for serverless)
# Get it from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-YOURPROJECT.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Admin authentication ─────────────────────────────────────────────────────
# Temporary credential-based auth — replace with DB session when ready.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
# Random secret used to sign session tokens (min 32 chars in production)
ADMIN_SECRET="replace-with-at-least-32-random-chars"

# ─── Cloudflare R2 image storage ──────────────────────────────────────────────
# Cloudflare dashboard → Account Home → (top-right) Account ID
R2_ACCOUNT_ID="your-cloudflare-account-id"
# Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API Token
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# The bucket you created (e.g. mojautodiler-media)
R2_BUCKET_NAME="mojautodiler-media"
# R2 → your bucket → Settings → Public access → Custom domain or r2.dev URL
# e.g. https://pub-abc123.r2.dev  OR  https://media.yourdomain.com
R2_PUBLIC_URL="https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev"
